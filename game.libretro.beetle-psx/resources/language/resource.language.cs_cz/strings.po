msgctxt "#30166"
msgid "Enable multitap functionality on port 1."
msgstr "Povolit funkci multitap na portu 1."

msgctxt "#30167"
msgid "Enable multitap functionality on port 2."
msgstr "Povolit funkci multitap na portu 2."

msgctxt "#30168"
msgid "Use mouse-controlled 'Light Gun' or 'Touchscreen' input when device type is set to 'Guncon/G-Con 45' or 'Justifier'."
msgstr "Použít vstup světelné pistole nebo dotykové obrazovky ovládaný myší, když je typ zařízení nastaven na „Guncon/G-Con 45“ nebo „Justifier“."

msgctxt "#30169"
msgid "Light Gun"
msgstr "Světelná pistole"

msgctxt "#30170"
msgid "Touchscreen"
msgstr "Dotyková obrazovka"

msgctxt "#30171"
msgid "Draw a cursor on screen while using the 'Guncon/G-Con 45' and 'Justifier' input device types."
msgstr "Při používání typů vstupních zařízení „Guncon/G-Con 45“ a „Justifier“ vykreslit na obrazovce kurzor."

msgctxt "#30172"
msgid "disabled"
