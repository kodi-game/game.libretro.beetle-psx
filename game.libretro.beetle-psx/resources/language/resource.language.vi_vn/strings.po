msgstr "Số chu kỳ tối đa CPU chạy trước khi kiểm tra cập nhật GPU/DMA/MDEC/Bộ hẹn giờ."

msgctxt "#30222"
msgid "128 (Default)"
msgstr "128 (Mặc định)"

msgctxt "#30223"
msgid "Max SPU samples to run before a SPU Update is checked, higher number will be faster, but will cause sound glitches in some games with anything other than 1."
msgstr "Số mẫu SPU tối đa để chạy trước khi kiểm tra Cập nhật SPU, số cao hơn sẽ nhanh hơn, nhưng có thể gây lỗi âm thanh trong một số game nếu khác 1."

