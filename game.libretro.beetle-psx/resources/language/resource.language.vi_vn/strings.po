msgid "Force 16:9"
msgstr ""

msgctxt "#30117"
msgid "Full native image or no borders."
msgstr "Hiển thị toàn bộ hình ảnh gốc hoặc không có viền đen."

msgctxt "#30118"
msgid "Disabled"
msgstr ""

msgctxt "#30119"
msgid "Horizontal"
