From 9bb519f2d9250b59fa56cb04b1340a798e85625d Mon Sep 17 00:00:00 2001
From: Garrett Brown <themagnificentmrb@gmail.com>
Date: Sat, 5 Sep 2026 01:38:54 -0700
Subject: [PATCH 1/3] Honor the no-disc image index

Selecting "No disc" passed the image count to the setter, which clamped
it to the last disc. Handle that request by selecting -1 and ejecting
without changing the playlist.

After removing the last image, the valid no-disc request is index 0.
Handle it before the empty-list guard so the setter can report success.
---
 libretro.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/libretro.c b/libretro.c
index 3c19e9a9..e7f85f62 100644
--- a/libretro.c
+++ b/libretro.c
@@ -4206,9 +4206,15 @@ static bool disk_set_image_index(unsigned index)
 {
    unsigned num_images = disk_get_num_images();
 
-   /* The frontend's contract on this callback is that index is in
-    * [0, num_images). Be defensive: refuse impossible values rather
-    * than letting them flow through to CD_SelectedDisc--. */
+   /* An index of num_images is a request to eject the disc in the libretro API. */
+   if (index == num_images)
+   {
+      eject_state = true;
+      CD_SelectedDisc = -1;
+      DoSimpleCommand(MDFN_MSC_EJECT_DISK);
+      return true;
+   }
+
    if (num_images == 0)
       return false;
    if (index >= num_images)
